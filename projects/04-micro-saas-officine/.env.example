# Copia questo file in .env e sostituisci i valori MOCK_ con quelli reali
# quando sei pronto ad andare live. Finché restano MOCK_, l'SMS al cliente
# è simulato (loggato, nessuna chiamata di rete). Vedi CONFIGURAZIONE.md.

# --- Twilio (SMS "veicolo pronto" e richiami tagliando) ---------------
# Da: console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=MOCK_ACCOUNT_SID
TWILIO_AUTH_TOKEN=MOCK_AUTH_TOKEN
# Il numero SMS che compri su Twilio (formato E.164, es. +390212345678)
TWILIO_NUMERO_SMS=MOCK_+390000000000

# --- Database -----------------------------------------------------------
OFFICINA_DB=officina.db

# --- Rate limit login (protezione anti-brute-force) ---------------------
# Tentativi di login massimi per IP per ora prima del 429
LOGIN_RATE_LIMIT=10
