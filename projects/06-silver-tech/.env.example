# Copia questo file in .env e sostituisci i valori MOCK_ con quelli reali
# quando sei pronto ad andare live. Finché restano MOCK_, la chiamata
# uscente è simulata (loggata, nessuna chiamata reale). Vedi CONFIGURAZIONE.md.

# --- Twilio (stesso account del progetto 01 — riuso dello stack) --------
TWILIO_ACCOUNT_SID=MOCK_ACCOUNT_SID
TWILIO_AUTH_TOKEN=MOCK_AUTH_TOKEN
TWILIO_PHONE_NUMBER=MOCK_+390000000000

# --- FiloDiretto: chi chiamare e dove Twilio deve rispondere -------------
FILODIRETTO_NUMERO_ASSISTITO=MOCK_+393339998877
# URL del webhook che genera il TwiML della conversazione (server.js del
# progetto 01, con FLOW=flows/filodiretto.json — vedi CONFIGURAZIONE.md)
FILODIRETTO_WEBHOOK_URL=MOCK_https://tuoapp.esempio.it/voice/incoming
# URL di QUESTO dashboard.py, dove Twilio segnala se l'assistito ha risposto
FILODIRETTO_STATUS_CALLBACK_URL=MOCK_https://tuoapp.esempio.it/voice/stato-chiamata
# L'URL pubblico ESATTO di questo dashboard.py — deve combaciare con quello
# messo sopra, altrimenti la firma X-Twilio-Signature non verrà mai validata
FILODIRETTO_PUBLIC_URL=MOCK_https://tuoapp.esempio.it

# --- Accesso famiglia -----------------------------------------------------
# Protegge /stato, /report-settimanale, /consenso, /richiedi-chiamata-extra:
# dati particolari (art. 9 GDPR), quindi con il valore ancora mock l'accesso
# resta SEMPRE negato. Genera il tuo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FILODIRETTO_ACCESS_TOKEN=MOCK_cambia_questo_token_prima_di_andare_live

# --- Percorsi --------------------------------------------------------------
EVENTI_LOG=eventi.jsonl
CONSENSO_PATH=consenso.json
FILODIRETTO_DASHBOARD_PORT=8030
