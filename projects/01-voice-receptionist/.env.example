# Copia questo file in .env e sostituisci i valori MOCK_ con quelli reali
# quando sei pronto ad andare live. Finché restano MOCK_, tutte le
# integrazioni funzionano in modalità simulata (loggano, non chiamano
# API vere né spendono credito). Vedi CONFIGURAZIONE.md per la guida
# passo-passo a come ottenere ogni credenziale.

# --- Twilio (telefonia + WhatsApp) ---------------------------------
# Da: console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=MOCK_ACCOUNT_SID
TWILIO_AUTH_TOKEN=MOCK_AUTH_TOKEN
# Il numero di telefono che compri su Twilio (formato E.164, es. +390212345678)
TWILIO_PHONE_NUMBER=MOCK_+390000000000
# Per WhatsApp serve il Twilio WhatsApp Sandbox (test) o un numero
# WhatsApp Business API approvato (produzione)
TWILIO_WHATSAPP_FROM=MOCK_whatsapp:+390000000000

# --- Notifiche al titolare ------------------------------------------
# Il numero WhatsApp del titolare che riceve le notifiche (formato E.164)
NOTIFICHE_NUMERO_TITOLARE=MOCK_+393331234567

# --- Google Calendar --------------------------------------------------
# Da: console.cloud.google.com → crea progetto → abilita "Google Calendar API"
#     → crea credenziali OAuth2 → ottieni un refresh token (vedi CONFIGURAZIONE.md)
GOOGLE_CALENDAR_CLIENT_ID=MOCK_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=MOCK_CLIENT_SECRET
GOOGLE_CALENDAR_REFRESH_TOKEN=MOCK_REFRESH_TOKEN
GOOGLE_CALENDAR_ID=MOCK_calendario@studio.it

# --- Attivazione integrazioni ----------------------------------------
# 0 (default) = le Azioni loggano soltanto, nessuna chiamata esterna
# 1 = le Azioni chiamano davvero notifiche.js/calendario.js (che restano
#     comunque simulate finché le credenziali sopra sono MOCK_)
INTEGRAZIONI_ATTIVE=0

# --- Log e flusso -----------------------------------------------------
# Percorso del log eventi (usato da valore.js e suggerimenti.js)
EVENTI_LOG=eventi.jsonl
# Quale flusso conversazionale caricare
FLOW=flows/dentista.json
