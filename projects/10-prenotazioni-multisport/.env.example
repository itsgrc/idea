# Copia questo file in .env e sostituisci i valori MOCK_ con quelli reali
# quando sei pronto ad andare live. Finché restano MOCK_, SMS e depositi
# sono simulati (loggati, nessuna chiamata di rete). Vedi CONFIGURAZIONE.md.

# --- Twilio (SMS conferma/promemoria) ------------------------------------
TWILIO_ACCOUNT_SID=MOCK_ACCOUNT_SID
TWILIO_AUTH_TOKEN=MOCK_AUTH_TOKEN
TWILIO_NUMERO_SMS=MOCK_+390000000000

# --- Stripe (deposito anti no-show) --------------------------------------
# Da: dashboard.stripe.com → Sviluppatori → Chiavi API
STRIPE_SECRET_KEY=MOCK_sk_test_xxx
# Da: dashboard.stripe.com → Sviluppatori → Webhook → aggiungi endpoint
# (.../webhook/stripe, evento "checkout.session.completed") → Signing secret
STRIPE_WEBHOOK_SECRET=MOCK_whsec_xxx
STRIPE_SUCCESS_URL=MOCK_https://tuoapp.esempio.it/pagamento-ok
STRIPE_CANCEL_URL=MOCK_https://tuoapp.esempio.it/pagamento-annullato

# --- Database e orari -----------------------------------------------------
CAMPOLIBERO_DB=campolibero.db
# Finestra di apertura applicata a tutte le risorse (semplificazione MVP)
CAMPOLIBERO_APERTURA=08:00
CAMPOLIBERO_CHIUSURA=23:00
