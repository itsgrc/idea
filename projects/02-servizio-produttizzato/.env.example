# Copia in .env e sostituisci i valori MOCK_ quando sei pronto a inviare
# email vere. Finché restano MOCK_, invio.py resta in DRY-RUN: stampa
# cosa invierebbe, non tocca la rete. Vedi CONFIGURAZIONE.md.

# --- SMTP (invio email reale) ---------------------------------------
# Con Gmail: serve una "password per le app" (myaccount.google.com/apppasswords),
# non la password normale dell'account. Con un provider professionale
# (Aruba, Register.it, ecc.) usa le credenziali fornite dal pannello email.
SMTP_HOST=MOCK_smtp.esempio.it
SMTP_PORT=587
SMTP_USER=MOCK_info@tuastudio.it
SMTP_PASSWORD=MOCK_password
SMTP_MITTENTE=MOCK_info@tuastudio.it
