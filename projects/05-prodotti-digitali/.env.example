# Copia questo file in .env e sostituisci i valori MOCK_ con quelli reali
# quando sei pronto ad andare live. Finché restano MOCK_, l'invio email è
# simulato (loggato, nessuna email reale spedita). Vedi CONFIGURAZIONE.md.

# --- SMTP (email di conferma iscrizione / double opt-in) ----------------
SMTP_HOST=MOCK_smtp.esempio.it
SMTP_PORT=587
SMTP_USER=MOCK_info@cantiereaperto.test
SMTP_PASSWORD=MOCK_password
SMTP_MITTENTE=MOCK_info@cantiereaperto.test

# --- Sicurezza -----------------------------------------------------------
# Protegge GET /iscritti (lista email confermate): senza una chiave reale,
# l'accesso resta SEMPRE negato (vedi commento nel codice). Genera la tua:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEWSLETTER_API_KEY=MOCK_cambia_questa_chiave_prima_di_andare_live

# L'URL pubblico ESATTO su cui questo server è raggiungibile: usato per
# comporre il link di conferma nell'email (deve poter essere aperto da chi
# la riceve, quindi NON localhost in produzione).
NEWSLETTER_PUBLIC_URL=http://localhost:8020

# --- Rate limit -----------------------------------------------------------
NEWSLETTER_RATE_LIMIT=5

# --- Database --------------------------------------------------------------
NEWSLETTER_DB=newsletter.db
