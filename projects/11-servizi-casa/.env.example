# Copia questo file in .env e sostituisci i valori MOCK_ con quelli reali
# quando sei pronto ad andare live. Finché restano MOCK_, l'SMS è
# simulato (loggato, nessuna chiamata di rete). Vedi CONFIGURAZIONE.md.

# --- Twilio (SMS proposta al professionista + conferma al cliente) ------
TWILIO_ACCOUNT_SID=MOCK_ACCOUNT_SID
TWILIO_AUTH_TOKEN=MOCK_AUTH_TOKEN
TWILIO_NUMERO_SMS=MOCK_+390000000000

# --- Database --------------------------------------------------------------
PRONTOCASA_DB=prontocasa.db

# --- Rate limit ------------------------------------------------------------
LOGIN_RATE_LIMIT=10
RICHIESTE_RATE_LIMIT=10
