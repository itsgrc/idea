# Copia in .env e sostituisci i valori MOCK_. Finché restano MOCK_, le
# notifiche di nuovi lead sono simulate (loggate) — il salvataggio del
# lead in lead.jsonl invece è SEMPRE reale, indipendentemente da questo.

SMTP_HOST=MOCK_smtp.esempio.it
SMTP_PORT=587
SMTP_USER=MOCK_info@tuostudio.it
SMTP_PASSWORD=MOCK_password
SMTP_MITTENTE=MOCK_info@tuostudio.it
# L'email che riceve la notifica di ogni nuovo lead (probabilmente la tua)
NOTIFICA_LEAD_A=MOCK_te@tuostudio.it

# Porta del server assessment + lead capture
LEAD_PORT=8010
